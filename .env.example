# Base de datos PostgreSQL 18
# En desarrollo local: jdbc:postgresql://localhost:5432/guantes_db
# En producción AWS RDS (con SSL obligatorio): jdbc:postgresql://<endpoint-rds>:5432/guantes_db?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/guantes_db
SPRING_DATASOURCE_USERNAME=usuario_ejemplo
SPRING_DATASOURCE_PASSWORD=reemplazar_por_contrasena_segura

# Perfil de Spring Boot (usar 'prod' en AWS EC2 detrás de CloudFront)
SPRING_PROFILES_ACTIVE=prod

# Autenticación JWT (obligatorio: mínimo 32 bytes / 256 bits)
JWT_SECRET=reemplazar_por_secreto_aleatorio_de_al_menos_32_bytes_seguros

# Orígenes permitidos para CORS (en desarrollo: http://localhost:5173; en AWS: https://<distribucion>.cloudfront.net)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Credenciales del usuario administrador inicial creado al arranque (opcional si ya existe)
ADMIN_EMAIL=admin.ejemplo@ucc.edu.co
ADMIN_PASSWORD=reemplazar_por_contrasena_admin_segura

# Puerto HTTP del servidor
PORT=8080
